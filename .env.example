OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
VECTOR_STORE_PROVIDER=local
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-flash-latest
LOCAL_MODEL_MODE=true
DATABASE_URL=
USE_METADATA_DB=true
REPOMIND_DATA_DIR=data
MAX_FILE_SIZE_BYTES=300000
MAX_CHUNKS_PER_REPO=5000
MAX_FILES_PER_REPO=15000
MAX_TOTAL_REPO_BYTES=250000000
BINARY_METADATA_ENABLED=true
FOLLOW_SYMLINKS=false
PARSER_PROVIDER=tree_sitter
ANALYSIS_ASYNC_ENABLED=true

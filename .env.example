# --- LLM (all optional; RepoMind answers deterministically without them) ---
# auto = Gemini if GEMINI_API_KEY is set, else an OpenAI-compatible endpoint if configured. off = never call an LLM.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Any OpenAI-compatible Chat Completions API: OpenAI, Ollama (http://localhost:11434/v1), vLLM, LM Studio, Groq...
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
LOCAL_MODEL_MODE=true

# --- Retrieval ---
# local = offline code-aware hashing embeddings; sentence-transformers / auto = semantic (requires requirements-advanced.txt)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
VECTOR_STORE_PROVIDER=local
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Answers abstain ("not found in this repo") when evidence is below these thresholds.
EVIDENCE_MIN_COVERAGE=0.6
EVIDENCE_RERANK_THRESHOLD=0.5
PARSER_PROVIDER=tree_sitter

# --- Storage ---
REPOMIND_DATA_DIR=data
DATABASE_URL=
USE_METADATA_DB=true

# --- Ingestion limits ---
MAX_FILE_SIZE_BYTES=300000
MAX_CHUNKS_PER_REPO=5000
MAX_FILES_PER_REPO=15000
MAX_TOTAL_REPO_BYTES=250000000
MAX_REPO_SIZE_MB=1024
GIT_HISTORY_DEPTH=50
CLONE_TIMEOUT_SECONDS=300
BINARY_METADATA_ENABLED=true
FOLLOW_SYMLINKS=false

# --- Network-backed analysis (disable for fully offline runs) ---
OSV_SCAN_ENABLED=true
GITHUB_API_CHECKS_ENABLED=true
# Optional token for the GitHub API size pre-check (avoids the 60 req/h anonymous limit). Read-only/no scopes is enough.
# Clones are also capped on disk at MAX_REPO_SIZE_MB, so a failed pre-check never means an unbounded clone.
GITHUB_TOKEN=

# --- API ---
# When set, every API call must send X-API-Key: <value> (the Streamlit UI reads it from this variable too).
REPOMIND_API_KEY=
RATE_LIMIT_PER_MINUTE=60
# Comma-separated proxy IPs/CIDRs (e.g. 10.0.0.0/8) allowed to set X-Forwarded-For. Leave empty unless behind a reverse proxy.
TRUSTED_PROXIES=
ANALYSIS_WORKERS=2
LOG_LEVEL=INFO

# docker compose only
POSTGRES_PASSWORD=

# Index one copy of byte-identical files.
COLLAPSE_DUPLICATE_FILES=true
# Metadata DB failure policy: auto (JSON fallback only for the implicit SQLite file), true, or false.
METADATA_DB_FALLBACK=auto
ANALYSIS_QUEUE_CAPACITY=8
